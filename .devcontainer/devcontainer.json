{
  "name": "TrainingGround Dev Env",
  "image": "mcr.microsoft.com/devcontainers/python:3",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "postCreateCommand": "npm install -g @google/gemini-cli @openai/codex"
}